# Copy to .env (gitignored) and fill in. Never commit the real file.

# Enables Claude for label-section selection. Without it the agents still run,
# using deterministic keyword matching - the response says which was used.
ANTHROPIC_API_KEY=sk-ant-...

# Domain holding the agents' ANS identity TXT records.
ANS_DOMAIN=scriptsync.health

# Check the DNS key anchor on /identity.
ANS_DNS_VERIFY=1

# Temporary: scriptsync.health has an orphaned DS record at the .health
# registry, so validating resolvers SERVFAIL the zone. Remove this line once
# the registrar clears it.
ANS_ALLOW_UNVALIDATED_DNS=1

# GoDaddy Developer API credentials (https://developer.godaddy.com/keys)
GODADDY_API_KEY=h2ozUDf7Nkrk_DxtDvHeKuRwEniLcrdckpF
GODADDY_API_SECRET=9eigzNJoNZ6azGabGzesr7

# Use "https://api.ote-godaddy.com" for GoDaddy's sandbox/test environment,
# or "https://api.godaddy.com" for production. Use OTE until the team's real
# domain is confirmed and paid for (see CLAUDE.md "Open: buy/confirm the
# domain we own for ANS names and DNS TXT keys").
GODADDY_API_BASE=https://api.ote-godaddy.com

# GoDaddy's free production Agent Name Service (ANS) -- a SEPARATE product
# from the domain-DNS API above (it doesn't require GoDaddy to host the
# domain). Get a Production key at the CLASSIC developer portal, not the
# newer one: https://classic-developer.godaddy.com/keys
# Registration API (endpoint/payload) not wired up yet -- see src/ans/godaddyAns.ts.
GODADDY_ANS_API_KEY= 
GODADDY_ANS_API_SECRET= 

# Verification service on 8081
PORT=8081

# How long a live challenge (POST /agents/challenge) stays valid, in seconds
CHALLENGE_TTL_SECONDS=120

# How long a registered agent identity stays "current" before it needs
# re-registration. The POST /verify "current" check fails once this passes.
IDENTITY_TTL_SECONDS=86400

# "simulated" (default) or "live". Must stay "simulated" until DNS + GoDaddy
# are wired to the team's real, owned domain -- required by the hard rule:
# "Be honest about what is live vs cached vs simulated."
VERIFICATION_MODE=simulated
